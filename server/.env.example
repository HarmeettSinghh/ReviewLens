# Server Port
PORT=4000

# Client Origin for CORS (e.g. https://reviewlens.vercel.app)
# Leave empty for local development to allow all origins.
CLIENT_ORIGIN=

# SQLite Database Connection String
DATABASE_URL="file:./dev.db"

# Google Gemini API Credentials & Model Selection
# Recommended: gemini-flash-latest or gemini-2.5-flash
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-flash-latest

# Optional Gemini Configuration
GEMINI_API_VERSION=v1beta
GEMINI_TIMEOUT_MS=30000

# Sequential Batching Throttle (Delay in milliseconds between batches)
AI_BATCH_DELAY_MS=100
